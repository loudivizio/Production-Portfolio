<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Selected video productions and multimedia storytelling by Lou DiVizio"><title>Lou DiVizio | Production Portfolio</title><style>:root{--ink:#14283e;--accent:#315c83;--light:#eef3f7}*{box-sizing:border-box}body{margin:0;font:16px/1.6 system-ui,-apple-system,Segoe UI,Arial,sans-serif;color:#233343;background:#f5f7f9}header{background:#17324b;color:white;padding:60px 24px 45px}main,.inner{max-width:1500px;margin:auto}header h1{font-size:clamp(2.1rem,5vw,3.5rem);margin:0;letter-spacing:.02em}header p{max-width:780px}header a{color:#e2f0ff}h2{color:var(--ink);font-size:1.45rem;border-bottom:2px solid #c9d6e1;padding-bottom:10px;margin-top:45px}main{padding:10px 24px 65px}.intro{font-size:1.05rem}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{background:white;border:1px solid #dae2e9;border-radius:12px;overflow:hidden;box-shadow:0 4px 14px #14283e0b}.card .body{padding:20px}.card h3{margin:0 0 10px;line-height:1.3;color:#234c71}.card p{margin:10px 0}.tag{display:inline-block;background:var(--light);color:#34546c;border-radius:20px;padding:3px 10px;font-size:.78rem;font-weight:700;letter-spacing:.03em}.video{position:relative;aspect-ratio:16/9;background:#102a41}.video iframe{position:absolute;width:100%;height:100%;border:0}.watch{display:inline-block;background:#315c83;color:white;padding:9px 15px;border-radius:6px;text-decoration:none;font-weight:650;margin-top:7px}.watch:hover{background:#17324b}footer{text-align:center;padding:30px;color:#667; font-size:.9rem}@media print{header{padding:20px;background:white;color:black}header a{color:#315c83}.video{display:none}.card{break-inside:avoid}.watch{color:#315c83;background:none;padding:0}body{background:white}} .pbs-fallback{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;color:white}.pbs-fallback .watch{margin:0}.pbs-fallback span{font-weight:700;letter-spacing:.08em}
/* Wider editorial layout and distinct section headings */
main{padding:18px 30px 75px}
main h2{font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.85rem,2.4vw,2.65rem);font-weight:700;line-height:1.16;letter-spacing:-.025em;color:#17324b;border-bottom:1px solid #bfd1dd;border-left:6px solid #29a6b1;padding:5px 0 16px 19px;margin:60px 0 24px}
.card h3{font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif;font-size:1.13rem;line-height:1.32;margin-top:12px}
.tag{background:#e0f4f3;color:#155b64}
@media(max-width:1050px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){main{padding:12px 18px 50px}.grid{grid-template-columns:1fr}main h2{margin-top:42px;font-size:1.8rem}header{padding:42px 18px 32px}}
@media print{.grid{grid-template-columns:repeat(2,minmax(0,1fr))}main h2{color:#17324b}}
</style></head><body><header><div class="inner"><h1>LOU DIVIZIO</h1><p><strong>JOURNALIST · MULTIMEDIA PRODUCER · PRODUCTION LEADER</strong></p><p>Austin, TX · <a href="mailto:loudivizio@gmail.com">loudivizio@gmail.com</a> · <a href="tel:+12487031937">248-703-1937</a> · <a href="https://www.linkedin.com/in/louis-divizio/" target="_blank" rel="noopener">LinkedIn</a></p><p>Multimedia journalist and production leader experienced in original reporting, broadcast production, video editing and field production management. Skilled in developing compelling stories, producing complete television programs and supervising camera, lighting and audio crews.</p></div></header><main><p class="intro">Selected New Mexico PBS broadcast and multimedia projects demonstrating editorial production, storytelling, writing, anchoring, editing and crew supervision. Each project identifies my specific role.</p><h2>Multimedia Storytelling</h2><div class="grid" id="reporting"></div><h2>Broadcast Production &amp; Editorial Leadership</h2><div class="grid" id="broadcast"></div><h2>Live-to-Tape Interviews</h2><div class="grid" id="interviews"></div><h2>News Anchoring</h2><div class="grid" id="anchoring"></div><h2>Production Management &amp; Crew Leadership</h2><div class="grid" id="leadership"></div></main><footer>Lou DiVizio · Selected work from New Mexico PBS</footer><script>const projects=[['reporting','New Mexico Search and Rescue Training Mission - Hunting for Clues','An original feature examining the volunteer-driven New Mexico Search and Rescue Operations. Our crews document the shift between the frenetic hours of looking for a live subject to the search for clues months later.','Developed the story; co-wrote and edited the script and all video for the segment; planned overall production.','FR2aOwrA4hM'],['reporting','Raton Seeks Revival in the Outdoors','An original feature examining how Raton, New Mexico, is working to diversify its dwindling local economy through outdoor recreation.','Developed the story; produced, co-wrote and edited all video for the segment; contributed to camera and lighting work; supervised the overall production.','WmWwpL-t2a0'],['reporting','Planting Seeds in a Burn Scar',"An original report examining scientists’ efforts to restore forests devastated by the largest wildfire in New Mexico history.",'Produced, co-wrote and edited all video for the segment; contributed to camera and lighting work; supervised the overall production.','iudYKujxOuo'],['reporting','Water Debts and Climate Change Are Drying NM Rivers, Reservoirs','A public-affairs story examining water debts, climate change and their impact on New Mexico waterways.','Developed the story; produced, co-wrote and edited the segment; contributed to camera and lighting work; supervised the overall production.','91bDSKjq07A'],['broadcast','Full Broadcast Program — Medical Malpractice Debate; FEMA Payout Questioned','Weekly episode of New Mexico in Focus centered around a key issue of the 2026 legislative session: medical malpractice reform.','Produced, wrote and edited the show; oversaw shooting, lighting and editing of individual segments. Additional full-length broadcast productions available upon request.','rXDZh0XvObo'],['leadership','Slam Poet Gigi “Bella” Guajardo','A production featuring slam poet Gigi “Bella” Guajardo.','Supervised the crew responsible for lighting, camera and audio capture.','1shWC3N3p34'],['leadership','Quilting History, Susan Hudson','A production featuring Susan Hudson and indigenous quilting history.','Supervised the crew responsible for lighting, camera and audio capture.','s0oGnWGrxXI'],['leadership','White Sands Complicated History, Explored Through Adobe','An interview with an artist exploring the history of White Sands through adobe.','Supervised the crew responsible for lighting, camera and audio capture.','pydk2Pw54Qg'],['leadership','Lili Elbe at The Santa Fe Opera','A production on a groundbreaking trans-centred opera, Lili Elbe, at The Santa Fe Opera.','Supervised the crew responsible for lighting, camera and audio capture.','s1sTKGn9QZQ'] ];
projects[4][1]='Medical Malpractice Debate; FEMA Payout Questioned';
for (const p of projects) { if(p[0]==='reporting') p[5]='Field Producing, Writing and Video Editing'; }
projects[0][5]='Writing and Video Editing';
 const additions=[["reporting","Downtown Albuquerque Neighborhoods Weigh Proposed Soccer Stadium","Residents in two downtown Albuquerque neighborhoods share their thoughts on the possibility of a new soccer stadium coming into their area.","Researched, pitched, wrote and edited the story. Field produced and interviewed guests in the field.","cYjUUuNWjjo","Original Reporting"],["reporting","New Sign Marks Trinity Site’s 80th Anniversary","NMiF visits the Trinity Site in Southern New Mexico, where a new sign now stands to acknowledge the human toll of the nuclear bomb that first exploded there 80 years ago.","Wrote and edited this nat-pack with no direction, just raw video.","fx9u78bB13A","Writing and Video Editing"],["broadcast","Budget Balancing Act; Healthy Soil and Water in NM","New Mexico in Focus zeros in on the state's budget as lawmakers work to finalize a massive spending plan in the 2026 regular legislative session.","Produced, wrote and edited the program. Booked and field produced interviews at the Capitol and on the banks of the Santa Fe River.","FLHGC3cPLMs"],["broadcast","NM Lawmakers Push Bills on ICE, Climate Goals","Limiting the authority of federal immigration officials has become a key issue for lawmakers at the 2026 legislative session in Santa Fe. NMiF speaks with lawmakers and local leaders about a bill that would ban public entities from contracting with ICE.","Produced, wrote and edited the program. Booked and field produced interviews inside the Capitol.","54uydo4oKC0"],["broadcast","The 2026 Legislative Session Begins","New Mexico in Focus is in Santa Fe for the start of the 2026 regular legislative session. Hear from lawmakers, advocates and executives involved in this year's key issues including ICE contracts, medical malpractice reform and oil & gas regulation.","Planned coverage of a large number of complex legislative issues. Produced, wrote and edited the program. Booked and field produced interviews inside the Capitol.","URab7WdxVnA"],["broadcast","WJRT 11PM Newscast - Sanford Dam Collapse","Received 2021 Emmy nomination for Best Newscast. Next-day coverage of catastrophic flooding in the Midland area, the response from President Trump & the federal government, and the community recovery effort.","Assigning, dispatching and coaching reporters in the field. Coordinating and executing live shots with reporters, anchors and directors. Built, wrote and produced the full newscast.","th9-GClbiP0"],["broadcast","WJRT 11PM Newscast - Tornado Touchdown","Breaking news coverage of a tornado touching down in mid-Michigan. Earned a 2019 Associated Press Award for Best Spot News.","Assigned and dispatched reporters to different locations. Communicated with reporters, anchors and directors during live shots. Built, wrote and produced the full broadcast.","n_nEU1v9bTo"],["interviews","U.S. Poet Laureate Arthur Sze on the Art of Translation","Senior Producer Lou DiVizio speaks with U.S. Poet Laureate Arthur Sze about his work as a poet and translator, and the relationship between his art and the state of New Mexico.","","WN0kRAyfTUU",null,13],["interviews","NM Epstein Truth Commission Chair on Scope of Investigation","Senior Producer Lou DiVizio interviews New Mexico State Rep. Andrea Romero, chair of the subcommittee known as the \"Epstein Truth Commission.\" Lou asks Romero about the commission’s work and if she believes this legislative body has the power to uncover everything there is to know about Epstein’s crimes in New Mexico.","","jsoxDY4h2wE",null,3],["interviews","How Trump’s Medicaid Cuts Could Close Several Rural Hospitals","Lou DiVizio interviews New Mexico's Legislative Finance Director and a former state senator about how federal Medicaid cuts will impact the state's rural healthcare systems.","","6yp4jjwmnsU"],["interviews","What a Second Trump Term Means for NM’s Indigenous Communities","Senior Producer Lou DiVizio and journalist Shaun Griswold consider what's next for New Mexico's Indigenous communities as the nation braces for a second Trump administration.","","DW7i7fRRnK0"],["interviews","Albuquerque Mayor Tim Keller","Lou DiVizio presses Albuquerque Mayor Tim Keller on some of his promises and accomplishments following Keller's State of the City address.","","",null,0,"https://www.pbs.org/video/albuquerque-mayor-tim-keller-sqii3m/"],["interviews","Celebrating Juneteenth in NM","In the first of three conversations, Senior Producer Lou DiVizio asks New Mexico Black community leaders Joe and Rita Powdrell about the roots of Juneteenth celebrations in New Mexico.","","NUVWwXuLOIg",null,32],["anchoring","Two Points of View as Legislature Rolls on","NMiF Senior Producer hosts as the show takes a status report of the legislative session to date.","Wrote, produced and anchored the newscast. Pitched and conducted an interview airing later in the show. Edited the other video elements.","TL3DcpwZRDM","Full Episode"],["anchoring","Las Cruces Shooting Context; New Lobo Hoops Coach","An update on the March shooting in Las Cruces that killed three teenagers and wounded more than a dozen others, expert analysis on how Project 2025's rollout will impact New Mexico and a check-in with sportswriter Geoff Grammer as the Lobos introduce a new basketball coach.","Wrote, produced and anchored the newscast. Pitched and conducted an interview airing later in the show. Edited the other video elements.","8FeaZcY-dY8","Full Episode"],["anchoring","Transparency at UNMPD; Self-Care is Community Care","Lou DiVizio hosts NMiF as U.S. Health and Human Services Secretary Robert F. Kennedy Jr. visits Hózhó Academy in Gallup. Later in the show, Lou sits down with Dr. Evalyn Plumb, a clinical psychologist with UNM's Project ECHO, to talk about a program focused on counteracting the impacts of the state's nation-leading rate of adverse childhood experiences.","Wrote, produced and anchored the newscast. Coordinated last-minute, after-hours field shoot hours away at RFK Jr. visit. Edited show video elements. Pitched and conducted interview airing later in the show.","GsbMphJVnZI","Full Episode",904],["anchoring","Outrage Over Racist Remarks by APD Officers","NMiF examines a recording that captures APD officers using racial slurs and violent language, taken moments after police shot and killed a 30-year-old man. Lou DiVizio hosts and later looks at the minimum wage employees are paid across the state, as Albuquerque’s City Council considers adjusting the rate.","Wrote, produced and anchored the newscast. Edited video and built graphics for body camera footage. Pitched, wrote and executed segment on potential minimum wage changes. Edited other video elements.","BIu4sVJuT2k","Full Episode"]];
projects.splice(4,0,...additions.filter(p=>p[0]==='reporting'));
projects.splice(projects.findIndex(p=>p[0]==='leadership'),0,...additions.filter(p=>p[0]==='broadcast'));
projects.push(...additions.filter(p=>p[0]==='interviews'||p[0]==='anchoring'));
function esc(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}for(const [category,title,description,role,id,badge,startSeconds=0,externalUrl] of projects){
 const card=document.createElement('article');card.className='card';
 const url=externalUrl || `https://www.youtube.com/watch?v=${id}${startSeconds?'&t='+startSeconds+'s':id==='FR2aOwrA4hM'?'&t=715s':id==='s1sTKGn9QZQ'?'&t=5s':''}`;
 const embedStart=startSeconds|| (id==='FR2aOwrA4hM'?715:0);
 const media=externalUrl ? `<div class="video pbs-video"><div class="pbs-fallback"><span>PBS Video</span><a class="watch" href="${esc(url)}" target="_blank" rel="noopener noreferrer">Watch on PBS ↗</a></div></div>` : `<div class="video"><iframe loading="lazy" src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}${embedStart?'?start='+embedStart:''}" title="${esc(title)}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>`;
 const label=badge || (category==='leadership'?'Crew Supervision':category==='broadcast'?'Full Program':category==='interviews'?'Live-to-Tape Interview':'Original Reporting');
 card.innerHTML=`${media}<div class="body"><span class="tag">${esc(label)}</span><h3>${esc(title)}</h3><p>${esc(description)}</p>${role?`<p><strong>My role:</strong> ${esc(role)}</p>`:''}<a class="watch" href="${esc(url)}" target="_blank" rel="noopener noreferrer">Watch on ${externalUrl?'PBS':'YouTube'} ↗</a></div>`;
 document.getElementById(category).appendChild(card);
}
</script></body></html>
